{
  "name": "factory-stock — low stock alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "factory-alert",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Webhook (low stock)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "factory-alert"
    },
    {
      "parameters": {
        "jsCode": "// payload จาก Apps Script: {item_id, ชื่อ, หน่วย, balance, ขั้นต่ำ}\nconst d = $input.first().json.body || $input.first().json;\nconst text = `🔔 ใกล้หมด\\n${d['ชื่อ']} (${d.item_id})\\nคงเหลือ ${d.balance} ${d['หน่วย']}\\nขั้นต่ำ ${d['ขั้นต่ำ']} ${d['หน่วย']}`;\nreturn [{ json: { text } }];"
      },
      "id": "format-1",
      "name": "Format message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/push",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"to\": \"REPLACE_WITH_OWNER_USERID\",\n  \"messages\": [{ \"type\": \"text\", \"text\": \"{{ $json.text }}\" }]\n}",
        "options": {}
      },
      "id": "line-1",
      "name": "LINE push",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_CREDENTIAL_ID", "name": "LINE Messaging API" }
      }
    }
  ],
  "connections": {
    "Webhook (low stock)": { "main": [[{ "node": "Format message", "type": "main", "index": 0 }]] },
    "Format message":     { "main": [[{ "node": "LINE push",      "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Bangkok" }
}
