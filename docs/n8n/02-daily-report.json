{
  "name": "factory-stock — daily report 18:00",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 18 * * *" }
          ]
        }
      },
      "id": "cron-1",
      "name": "Daily 18:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://script.google.com/macros/s/AKfycbz31uqRMAtGeMShTJr9pnbCo8_DwWNCk12dZPtkxd5wGXzvcT_2C79BhNid-3rIz6pvGw/exec",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "action", "value": "dailyReport" },
            { "name": "secret", "value": "REPLACE_WITH_N8N_SECRET" }
          ]
        },
        "options": {
          "redirect": { "redirect": { "followRedirects": true, "maxRedirects": 5 } }
        }
      },
      "id": "http-1",
      "name": "Fetch dailyReport",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "jsCode": "// format report + รวม LINE body เป็น string ไว้เลย\nconst OWNER_USERID = 'REPLACE_WITH_OWNER_USERID'; // ⬅ แก้ตรงนี้\n\nconst r = $input.first().json;\nlet text;\nif (!r.ok) {\n  text = '⚠️ Daily report error: ' + (r.error || 'unknown');\n} else {\n  const now = new Date(r.generated_at);\n  const date = now.toLocaleDateString('th-TH', { timeZone: 'Asia/Bangkok', day:'numeric', month:'short' });\n  const lines = [`📊 รายงานสต็อก ${date}`, ''];\n  r.categories.forEach(cat => {\n    lines.push(`▸ ${cat.category}`);\n    cat.items.forEach(it => {\n      const flag = it.isLow ? ' ⚠️' : '';\n      lines.push(`   ${it['ชื่อ']}: ${it.balance} ${it['หน่วย']}${flag}`);\n    });\n    if (cat.total_value != null) lines.push(`   มูลค่ารวม: ${cat.total_value.toLocaleString()} บาท`);\n    lines.push('');\n  });\n  if (r.low_items.length) lines.push(`⚠️ ใกล้หมด ${r.low_items.length} รายการ`);\n  text = lines.join('\\n').trim();\n}\n\nconst body = JSON.stringify({\n  to: OWNER_USERID,\n  messages: [{ type: 'text', text }],\n});\nreturn [{ json: { body } }];"
      },
      "id": "format-1",
      "name": "Build LINE body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/push",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ $json.body }}",
        "options": {}
      },
      "id": "line-1",
      "name": "LINE push",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_CREDENTIAL_ID", "name": "LINE Messaging API" }
      }
    }
  ],
  "connections": {
    "Daily 18:00":         { "main": [[{ "node": "Fetch dailyReport", "type": "main", "index": 0 }]] },
    "Fetch dailyReport":   { "main": [[{ "node": "Build LINE body",   "type": "main", "index": 0 }]] },
    "Build LINE body":     { "main": [[{ "node": "LINE push",         "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Bangkok" }
}
